{
  "manifest_version": 3,
  "name": "B站字幕笔记",
  "version": "1.2.0",
  "description": "把 B站 视频的字幕变成可核对的笔记：先验证这份字幕属不属于这个视频，再整理成带原句和时间戳的要点。不填 API Key 也能导出字幕全文。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "B站字幕笔记 · 搜我攒下的笔记",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "src/search.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "src/gate.js",
        "src/summarize.js",
        "src/batch.js",
        "src/hardsub.js",
        "src/frames.js",
        "src/searchindex.js",
        "src/course.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html"
}
